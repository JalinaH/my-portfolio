# Gemini API key and a currently supported text model.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail sender and app password. Recipient is configured in src/lib/portfolio.ts.
EMAIL_USER=
EMAIL_PASSWORD=

# Required in production: Redis REST endpoint supporting EVAL (e.g. Upstash).
KV_REST_API_URL=
KV_REST_API_TOKEN=
